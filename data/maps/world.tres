[sub_resource type="Resource" id="world_npc_node"]
script = ExtResource("node_script")
id = "greeting"
editor_label = "旅の案内"
text = "こんにちは、旅人さん。ここは町と洞窟をつなぐ野原です。\n東の道には背の高い草が続き、夕暮れには風の音が変わります。\n町では花の泉で体を休められます。遠い道へ進む前に立ち寄ってみてください。\n洞窟へ行くなら、足元にも気をつけて。暗い場所では急がずに進みましょう。\n困ったときは、またここへ戻ってきてくださいね。"

[sub_resource type="Resource" id="world_npc_dialogue"]
script = ExtResource("dialogue_script")
start_node_id = "greeting"
nodes = Array[ExtResource("node_script")]([SubResource("world_npc_node")])

